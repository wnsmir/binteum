# Optional: no key uses a local OSM Korea index when available.
# Pedestrian routes use Valhalla for local development only.
# Copy to server/.env (ignored by Git); never paste a provider key into app source.
KAKAO_REST_API_KEY=
PORT=3210

# Default: .local/maps/south-korea-pois.json relative to repository root.
LOCAL_POI_FILE=

# Experimental public Overpass only when the local index is absent; opt in explicitly.
NEARBY_USE_OVERPASS=0
